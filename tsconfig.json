{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@4bhiy/watchtower-core": ["./packages/core/src/index.ts"],
      "@watchtower/history": ["./packages/history/src/persist.ts"],
      "@watchtower/telegram": ["./packages/telegram/src/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages/*/src", "apps/cli/src", "tests"]
}
